{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PGlite package fork lineage",
  "description": "Identifies the upstream and fork wrapper and engine revisions, plus the native build toolchain, used to produce a package of this PGlite fork family.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseLine",
    "package",
    "wrapper",
    "engine",
    "build"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "releaseLine": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/v[0-9]+\\.[0-9]+(?:-[a-z0-9][a-z0-9-]*)?$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceDirectory"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^@[a-z0-9][a-z0-9-]*/pglite(?:-[a-z0-9-]+)?$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sourceDirectory": {
          "type": "string",
          "pattern": "^packages/pglite(?:-[a-z0-9-]+)?$"
        }
      }
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "fork"],
      "properties": {
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "packageName", "packageVersion"],
          "properties": {
            "repository": {
              "const": "https://github.com/electric-sql/pglite"
            },
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "packageName": {
              "type": "string",
              "pattern": "^@electric-sql/pglite(?:-[a-z0-9-]+)?$"
            },
            "packageVersion": {
              "$ref": "#/$defs/version"
            }
          }
        },
        "fork": {
          "$ref": "#/$defs/forkWrapper"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "fork"],
      "properties": {
        "upstream": {
          "$ref": "#/$defs/upstreamEngine"
        },
        "fork": {
          "$ref": "#/$defs/forkEngine"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgresqlVersion", "emscriptenSdkVersion", "builderImage"],
      "properties": {
        "postgresqlVersion": {
          "type": "string",
          "minLength": 1
        },
        "emscriptenSdkVersion": {
          "type": "string",
          "minLength": 1
        },
        "builderImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "digest"],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "forkWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://[^\\s/]+/[^\\s/]+/pglite$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "upstreamEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "const": "https://github.com/electric-sql/postgres-pglite"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "forkEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://[^\\s/]+/[^\\s/]+/postgres-pglite$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    }
  }
}
